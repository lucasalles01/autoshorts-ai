# Environment Variables for Production
# These will be set in Render/Railway dashboard

# Server Configuration
PORT=3001
NODE_ENV=production

# Database (Supabase/Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Security
JWT_SECRET=your-jwt-secret-change-in-production-32bytes-min
ENCRYPTION_KEY=your-encryption-key-32-hex-chars-min

# Public URL (IMPORTANT for OAuth2)
# Replace with your actual backend URL after deploy
PUBLIC_BASE_URL=https://seu-backend.onrender.com

# OAuth2 Credentials (Set in Render dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Storage (Optional - Use Render Disk or Supabase Storage)
STORAGE_ENDPOINT=https://seu-backend.onrender.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=autoshorts-storage

# Other Config
FFMPEG_PATH=
FFPROBE_PATH=
YOUTUBE_PRIVACY_STATUS=private
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
INSTAGRAM_API_VERSION=v21.0
